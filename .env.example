# Server
PORT=3000
HOST=0.0.0.0
MCP_ENDPOINT=/mcp

# Allowed directories for file operations (comma-separated)
# On Windows: ALLOWED_DIRS=D:\AilyWorkspace
# On macOS/Linux: ALLOWED_DIRS=/Users/yourname/Documents
ALLOWED_DIRS=/tmp/mcp-workspace

# Auth token for MCP requests
# Generate a strong random token, e.g.: openssl rand -hex 32
MCP_AUTH_TOKEN=your-secret-token-here

# Tool authorization: pin | header | none (default: pin)
AUTH_MODE=pin

# Required when AUTH_MODE=pin. Must contain at least 8 characters.
# The value is never printed to stdout, stderr, or logs.
AUTH_PIN=

# Trusted request identity sources
AUTH_USER_HEADER=x-aily-user
AUTH_EMAIL_HEADER=x-aily-email
# Optional query-string fallback when the user header is absent
AUTH_USER_QUERY_PARAM=

# PIN sessions: false keeps only the most recently authenticated user.
AUTH_MULTI_USER=false
AUTH_MAX_USERS=8

# File size limits (bytes)
MAX_READ_BYTES=10485760    # 10 MB
MAX_WRITE_BYTES=5242880   # 5 MB

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MIN=60

# Soft-delete / recycle bin
TRASH_RETENTION_DAYS=7

# Operation audit log directory
LOG_DIR=logs
LOG_LEVEL=info
LOG_FORMAT=pretty

# ngrok tunnel (optional — only needed if you use the start script)
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
# Get your free domain from: https://dashboard.ngrok.com/domains
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=your-domain.ngrok-free.app
