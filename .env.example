# Server
PORT=3000
HOST=0.0.0.0
MCP_ENDPOINT=/mcp

# Allowed directories for file operations (comma-separated, Phase 2+)
# On Windows: ALLOWED_DIRS=D:\AilyWorkspace
# On macOS/Linux: ALLOWED_DIRS=/Users/yourname/Documents
ALLOWED_DIRS=/tmp/mcp-workspace

# Auth token for MCP requests (Phase 3+)
# Generate a strong random token, e.g.: openssl rand -hex 32
MCP_AUTH_TOKEN=your-secret-token-here

# File size limits (bytes, Phase 3)
MAX_READ_BYTES=10485760    # 10 MB
MAX_WRITE_BYTES=5242880   # 5 MB

# Rate limiting (requests per minute, Phase 3)
RATE_LIMIT_PER_MIN=60

# Soft-delete / recycle bin (Phase 3)
TRASH_RETENTION_DAYS=7

# Operation audit log directory (Phase 3)
LOG_DIR=logs

# Cloudflare Tunnel (Phase 4)
# Get a tunnel token from: https://one.dash.cloudflare.com/
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TUNNEL_DOMAIN=aily-mcp.yourdomain.com
