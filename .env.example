# Server
PORT=3000
HOST=0.0.0.0
MCP_ENDPOINT=/mcp

# Allowed directories for file operations (comma-separated)
# On Windows: ALLOWED_DIRS=D:\AilyWorkspace
# On macOS/Linux: ALLOWED_DIRS=/Users/yourname/Documents
ALLOWED_DIRS=/tmp/mcp-workspace

# Optional device-owner identity and owner-only default roots.
# For this deployment: OWNER_USER_ID=owner and OWNER_DEFAULT_DIRS=F:\
OWNER_USER_ID=
OWNER_DEFAULT_DIRS=
# Legacy Feishu clients without MCP input_required: deny | owner
DIRECTORY_APPROVAL_FALLBACK=deny

# Auth token for MCP requests
# Generate a strong random token, e.g.: openssl rand -hex 32
MCP_AUTH_TOKEN=your-secret-token-here

# Tool authorization: pin | header | none (default: pin)
AUTH_MODE=pin

# Required when AUTH_MODE=pin. Must contain at least 8 characters.
# The value is never printed to stdout, stderr, or logs.
AUTH_PIN=

# Trusted request identity sources
AUTH_USER_HEADER=x-aily-user
AUTH_EMAIL_HEADER=x-aily-email
# Optional query-string fallback when the user header is absent
AUTH_USER_QUERY_PARAM=

# PIN sessions: false keeps only the most recently authenticated user.
AUTH_MULTI_USER=false
AUTH_MAX_USERS=8

# Feishu in-window approval policies for filesystem paths: confirm | allow | deny
CONSENT_ABSOLUTE_PATH=confirm
CONSENT_SENSITIVE_FILE=confirm
# Legacy utility settings; production guarded actions never fall back to terminal input.
CONSENT_TIMEOUT_MS=60000
NON_INTERACTIVE=deny

# Complete local-development execution limits
MAX_CONCURRENT_TOOLS=8
MAX_CONCURRENT_COMMANDS=2
MAX_CONCURRENT_SEARCHES=2
MAX_CONCURRENT_FETCHES=4
TOOL_QUEUE_TIMEOUT_MS=30000
COMMAND_TIMEOUT_MS=30000
COMMAND_MAX_TIMEOUT_MS=300000
COMMAND_MAX_OUTPUT_BYTES=1048576
SEARCH_TIMEOUT_MS=30000
SEARCH_MAX_FILES=10000
SEARCH_MAX_RESULTS=1000
GIT_TIMEOUT_MS=30000
FETCH_TIMEOUT_MS=30000
FETCH_MAX_TIMEOUT_MS=120000
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
APPROVAL_TIMEOUT_MS=600000
# Optional explicit signing secret. Leave empty to use the protected local key file.
APPROVAL_STATE_SECRET=
# Default on Windows: %LOCALAPPDATA%\feishu-mcp
APPROVAL_DATA_DIR=

# Owner-only background development tasks (Phase 1).
# DEV_TASK_DATA_DIR defaults to <APPROVAL_DATA_DIR>/tasks and must stay inside it.
DEV_TASK_DATA_DIR=
DEV_MAX_TASKS=4
DEV_MAX_BUILDS=2
DEV_TASK_QUEUE_TIMEOUT_MS=900000
DEV_TASK_RETENTION_DAYS=14
DEV_TASK_MAX_TOTAL_BYTES=1073741824
DEV_TASK_LOG_MAX_BYTES=52428800
DEV_TASK_HEARTBEAT_MS=2000
DEV_TASK_CANCEL_GRACE_MS=5000
DEV_TASK_MAX_RUNTIME_MS=7200000

# File size limits (bytes)
MAX_READ_BYTES=10485760    # 10 MB
MAX_WRITE_BYTES=5242880   # 5 MB

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MIN=60

# Soft-delete / recycle bin
TRASH_RETENTION_DAYS=7

# Operation audit log directory
LOG_DIR=logs
LOG_LEVEL=info
LOG_FORMAT=pretty

# ngrok tunnel (optional — only needed if you use the start script)
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
# Get your free domain from: https://dashboard.ngrok.com/domains
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=your-domain.ngrok-free.app
